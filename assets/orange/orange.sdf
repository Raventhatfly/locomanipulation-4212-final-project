<?xml version="1.0"?>
<sdf version="1.7">
  <model name="orange">
    <link name="orange_link">
      <inertial>
        <mass>0.15</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>textured.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 0.5 0.0 1.0</diffuse>
          <ambient>1.0 0.5 0.0 1.0</ambient>
          <specular>0.3 0.3 0.3 1.0</specular>
        </material>
      </visual>
      
      <collision name="collision">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus>5e5</drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint>0.01</drake:mesh_resolution_hint>
          <drake:hunt_crossley_dissipation>100.0</drake:hunt_crossley_dissipation>
          <drake:mu_dynamic>1.0</drake:mu_dynamic>
          <drake:mu_static>1.5</drake:mu_static>
        </drake:proximity_properties>
      </collision>
    </link>
  </model>
</sdf>
