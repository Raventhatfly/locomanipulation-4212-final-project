<?xml version="1.0"?>
<sdf version="1.7">
  <model name="floor">
    <link name="floor_link">
      <collision name="floor_collision">
        <geometry>
          <box>
            <size>50 50 0.1</size>
          </box>
        </geometry>
        <drake:proximity_properties>
          <drake:point_contact_stiffness>10000</drake:point_contact_stiffness>
          <drake:hunt_crossley_dissipation>200.0</drake:hunt_crossley_dissipation>
          <drake:mu_dynamic>2.0</drake:mu_dynamic>
          <drake:mu_static>2.0</drake:mu_static>
        </drake:proximity_properties>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e7</kp>
              <kd>100.0</kd>
            </ode>
          </contact>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
          </bounce>
        </surface>
      </collision>
      <visual name="floor_visual">
        <geometry>
          <box>
            <size>50 50 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 0</ambient>
          <diffuse>0.8 0.8 0.8 0</diffuse>
          <specular>0.2 0.2 0.2 0</specular>
        </material>
      </visual>
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>1</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1</iyy>
          <iyz>0</iyz>
          <izz>1</izz>
        </inertia>
      </inertial>
    </link>
  </model>
</sdf>
