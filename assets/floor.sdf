<?xml version="1.0"?>
<sdf version="1.7">
  <model name="floor">
    <link name="floor_link">
      <collision name="floor_collision">
        <geometry>
          <box>
            <size>50 50 0.1</size>
          </box>
        </geometry>
        <drake:proximity_properties>
          <drake:rigid_hydroelastic/>
          <drake:hunt_crossley_dissipation>5.0</drake:hunt_crossley_dissipation>
          <drake:mu_dynamic>0.8</drake:mu_dynamic>
          <drake:mu_static>1.0</drake:mu_static>
        </drake:proximity_properties>
      </collision>
      <visual name="floor_visual">
        <geometry>
          <box>
            <size>50 50 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 0</ambient>
          <diffuse>0.8 0.8 0.8 0</diffuse>
          <specular>0.2 0.2 0.2 0</specular>
        </material>
      </visual>
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>1</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1</iyy>
          <iyz>0</iyz>
          <izz>1</izz>
        </inertia>
      </inertial>
    </link>
  </model>
</sdf>
