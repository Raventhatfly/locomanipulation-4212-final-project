<?xml version="1.0"?>
<sdf version="1.7">
  <model name="peach">
    <link name="peach_link">
      <inertial>
        <mass>0.12</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>textured.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 0.7 0.5 1.0</diffuse>
          <ambient>1.0 0.7 0.5 1.0</ambient>
          <specular>0.3 0.3 0.3 1.0</specular>
        </material>
      </visual>
      
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>textured.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <drake:proximity_properties>
          <drake:point_contact_stiffness>2000</drake:point_contact_stiffness>
          <drake:hunt_crossley_dissipation>200.0</drake:hunt_crossley_dissipation>
          <drake:mu_dynamic>2.0</drake:mu_dynamic>
          <drake:mu_static>2.0</drake:mu_static>
        </drake:proximity_properties>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>5e5</kp>
              <kd>1000.0</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <bounce>
            <restitution_coefficient>0.01</restitution_coefficient>
            <threshold>0.001</threshold>
          </bounce>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
